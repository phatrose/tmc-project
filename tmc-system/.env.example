# PHỤ TRÁCH: Task 8. Copy to .env and supply a local-only password. Never commit .env.
TMC_DB_USER=tmc
TMC_DB_PASSWORD=
# Optional shared token for Edge Gate Agent <-> Central preview sync/bootstrap (leave blank to keep edge routes closed).
TMC_EDGE_SHARED_TOKEN=
# Vite dev proxy target (not a secret, not embedded into the browser bundle).
TMC_CENTRAL_URL=http://127.0.0.1:8080
