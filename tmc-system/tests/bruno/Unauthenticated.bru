meta {
  name: Missing session returns ApiError
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}
tests {
  test("No implicit demo authentication", function () {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal("UNAUTHENTICATED");
    expect(res.body.retryable).to.equal(false);
    expect(res.body.requestId).to.equal(res.headers["x-request-id"]);
  });
}
